+    // Deliver any WT streams/datagrams that were buffered because they arrived
+    // before moqSession_ was created. Call once moqSession_ is set and started.
+    void drainPendingWtStreams() {
+      if (!moqSession_) {
+        return;
+      }
+      for (auto& handle : pendingBidiStreams_) {
+        moqSession_->onNewBidiStream(std::move(handle));
+      }
+      pendingBidiStreams_.clear();
+      for (auto* handle : pendingUniStreams_) {
+        moqSession_->onNewUniStream(handle);
+      }
+      pendingUniStreams_.clear();
+      for (auto& datagram : pendingDatagrams_) {
+        moqSession_->onDatagram(std::move(datagram));
+      }
+      pendingDatagrams_.clear();
+    }

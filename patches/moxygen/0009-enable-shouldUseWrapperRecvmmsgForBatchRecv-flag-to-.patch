Subject: [PATCH 09/16] enable shouldUseWrapperRecvmmsgForBatchRecv flag to
 enable recvmmsg path

---
 moxygen/MoQServer.cpp | 1 +
 1 file changed, 1 insertion(+)

diff --git a/moxygen/MoQServer.cpp b/moxygen/MoQServer.cpp
index 7266db6c..61c04cf4 100644
--- a/moxygen/MoQServer.cpp
+++ b/moxygen/MoQServer.cpp
@@ -91,6 +91,7 @@ MoQServer::MoQServer(
   params_.transportSettings = options.transportSettings
       ? *options.transportSettings
       : defaultTransportSettings();
+  params_.transportSettings.shouldUseWrapperRecvmmsgForBatchRecv = true;
 
   // UDP socket buffer sizes
   params_.udpSendBufferSize = options.udpSendBufferBytes > 0

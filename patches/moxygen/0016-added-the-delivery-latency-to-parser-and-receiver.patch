From: osmandagli <osman.dagli687@gmail.com>
Date: Tue, 22 Sep 2026 11:59:45 +0200
Subject: [PATCH 16/16] added the  delivery latency to parser and receiver

---
 moxygen/flv_parser/FlvStreamParser.cpp        |  5 +-
 .../MoQFlvReceiverClient.cpp                  | 59 +++++++++++++++++++
 2 files changed, 62 insertions(+), 2 deletions(-)

diff --git a/moxygen/flv_parser/FlvStreamParser.cpp b/moxygen/flv_parser/FlvStreamParser.cpp
index 14ff5e08..9809f66e 100644
--- a/moxygen/flv_parser/FlvStreamParser.cpp
+++ b/moxygen/flv_parser/FlvStreamParser.cpp
@@ -29,9 +29,10 @@ std::unique_ptr<FlvStreamParser::MediaItem> FlvStreamParser::parse(
 
   // Set FLV timebase
   localItem->timescale = kFlvTimeScale;
-  // Set wallclock here (NOT exact, but close enough in real live video)
+  // Set wallclock here (NOT exact, but close enough in real live video).
+  // Microseconds: used as the send timestamp for end-to-end latency measurement.
   localItem->wallclock =
-      std::chrono::duration_cast<std::chrono::milliseconds>(
+      std::chrono::duration_cast<std::chrono::microseconds>(
           std::chrono::system_clock::now().time_since_epoch())
           .count();
 
diff --git a/moxygen/samples/flv_receiver_client/MoQFlvReceiverClient.cpp b/moxygen/samples/flv_receiver_client/MoQFlvReceiverClient.cpp
index 5219cb06..11df3e0e 100644
--- a/moxygen/samples/flv_receiver_client/MoQFlvReceiverClient.cpp
+++ b/moxygen/samples/flv_receiver_client/MoQFlvReceiverClient.cpp
@@ -5,6 +5,8 @@
  */
 
 #include <folly/portability/GFlags.h>
+#include <chrono>
+#include <cstdio>
 #include <iostream>
 #include "moxygen/MoQClient.h"
 #include "moxygen/MoQWebTransportClient.h"
@@ -52,10 +54,32 @@ DEFINE_bool(
     insecure,
     false,
     "Use insecure verifier (skip certificate validation)");
+DEFINE_string(
+    latency_csv,
+    "",
+    "Write one row per received object to this file (empty = off). "
+    "Columns: recv_us,type,seq_id,wallclock_us,latency_us");
 
 namespace {
 using namespace moxygen;
 
+// Opened once on first use; null when --latency_csv is not set.
+FILE* latencyCsv() {
+  static FILE* csv = [] {
+    if (FLAGS_latency_csv.empty()) {
+      return static_cast<FILE*>(nullptr);
+    }
+    FILE* f = ::fopen(FLAGS_latency_csv.c_str(), "w");
+    if (f) {
+      ::fprintf(f, "recv_us,type,seq_id,wallclock_us,latency_us\n");
+    } else {
+      XLOG(ERR) << "Can't open --latency_csv=" << FLAGS_latency_csv;
+    }
+    return f;
+  }();
+  return csv;
+}
+
 class TrackType {
  public:
   enum MediaType { Audio, Video };
@@ -127,6 +151,23 @@ class TrackReceiverHandler : public ObjectReceiverCallback {
           std::make_unique<MoQMi::MoqMiObject>(
               objHeader.extensions.getMutableExtensions(), std::move(payload)));
       logData(payloadDecodedData);
+      // Latency is sampled here, before the dejitter buffer adds its delay.
+      if (auto* csv = latencyCsv()) {
+        if (auto wallclockUs = getWallclock(payloadDecodedData)) {
+          auto nowUs = std::chrono::duration_cast<std::chrono::microseconds>(
+                           std::chrono::system_clock::now().time_since_epoch())
+                           .count();
+          ::fprintf(
+              csv,
+              "%lld,%s,%llu,%llu,%lld\n",
+              static_cast<long long>(nowUs),
+              trackMediaType_.toStr().c_str(),
+              static_cast<unsigned long long>(
+                  getSeqId(payloadDecodedData).value_or(0)),
+              static_cast<unsigned long long>(*wallclockUs),
+              static_cast<long long>(nowUs - static_cast<int64_t>(*wallclockUs)));
+        }
+      }
       if (payloadDecodedData.index() ==
               MoQMi::MoqMIItemTypeIndex::MOQMI_ITEM_INDEX_VIDEO_H264_AVC ||
           payloadDecodedData.index() ==
@@ -255,6 +296,24 @@ class TrackReceiverHandler : public ObjectReceiverCallback {
     return std::nullopt;
   }
 
+  std::optional<uint64_t> getWallclock(
+      const MoQMi::MoqMiItem& payloadDecodedData) const {
+    if (payloadDecodedData.index() ==
+        MoQMi::MoqMIItemTypeIndex::MOQMI_ITEM_INDEX_VIDEO_H264_AVC) {
+      return std::get<
+                 MoQMi::MoqMIItemTypeIndex::MOQMI_ITEM_INDEX_VIDEO_H264_AVC>(
+                 payloadDecodedData)
+          ->wallclock;
+    } else if (
+        payloadDecodedData.index() ==
+        MoQMi::MoqMIItemTypeIndex::MOQMI_ITEM_INDEX_AUDIO_AAC_LC) {
+      return std::get<MoQMi::MoqMIItemTypeIndex::MOQMI_ITEM_INDEX_AUDIO_AAC_LC>(
+                 payloadDecodedData)
+          ->wallclock;
+    }
+    return std::nullopt;
+  }
+
   std::optional<uint64_t> getDurationMs(
       const MoQMi::MoqMiItem& payloadDecodedData) const {
     std::optional<uint64_t> dur;

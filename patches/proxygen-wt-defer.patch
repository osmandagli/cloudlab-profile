+// Re-dispatch WT ingress streams that arrived before the WebTransport session
+// was established on this side.
+void HQSession::flushPendingWTIngressStreams(
+    HQStreamTransportBase& connectStream) {
+  if (!pendingWTIngressUniStreams_.empty()) {
+    auto uniStreams = std::move(pendingWTIngressUniStreams_);
+    pendingWTIngressUniStreams_.clear();
+    for (auto streamID : uniStreams) {
+      VLOG(4) << __func__ << ": flushing deferred WT uni stream id=" << streamID
+              << " sess=" << *this;
+      auto* handle = connectStream.txn_.onWebTransportUniStream(streamID);
+      if (handle) {
+        sock_->setReadCallback(streamID, handle);
+      }
+    }
+  }
+  if (!pendingWTIngressBidiStreams_.empty()) {
+    auto bidiStreams = std::move(pendingWTIngressBidiStreams_);
+    pendingWTIngressBidiStreams_.clear();
+    for (auto streamID : bidiStreams) {
+      VLOG(4) << __func__ << ": flushing deferred WT bidi stream id=" << streamID
+              << " sess=" << *this;
+      auto handle = connectStream.txn_.onWebTransportBidiStream(streamID);
+      if (handle.readHandle) {
+        sock_->setReadCallback(streamID, handle.readHandle);
+      }
+    }
+  }
+}
